CLOUDTAK_Mode=docker-compose
CLOUDTAK_Config_media_url=http://media

SigningSecret=coe-wildland-fire

ASSET_BUCKET=cloudtak
AWS_S3_Endpoint=http://store:3900
AWS_S3_AccessKeyId=cloudtakstoreadmin
AWS_S3_SecretAccessKey=cloudtakstoreadmin
# Generated automatically by ./cloudtak.sh
GARAGE_RPC_SECRET=

POSTGRES=postgres://docker:docker@postgis:5432/gis

API_URL=http://localhost:5000
PMTILES_URL=http://tiles:5002

# Comma separated git URLs of web plugins, optionally pinned with #<tag|branch|sha>
WEB_PLUGINS=

# Comma separated sources appended to the matching Content-Security-Policy directive
NGINX_CSP_DEFAULT_SRC=
NGINX_CSP_IMG_SRC=
NGINX_CSP_MEDIA_SRC=
NGINX_CSP_FONT_SRC=
NGINX_CSP_WORKER_SRC=
NGINX_CSP_STYLE_SRC_ELEM=
NGINX_CSP_STYLE_SRC_ATTR=
NGINX_CSP_CONNECT_SRC=
